<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="surgical_world">

    <!-- 🌞 Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 🌍 Ground -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 🏥 OT Room -->
    <include>
      <uri>model://ot_room</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ================= INSTRUMENTS ================= -->

    <!-- 🔪 Scalpel -->
    <model name="scalpel_1">
      <pose>1.2 -4.6 2.5 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass></inertial>

        <collision name="collision">
          <geometry>
            <box><size>0.2 0.02 0.01</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>100</mu2></ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.2 0.02 0.01</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 🔧 Forceps -->
    <model name="forceps_1">
      <pose>1.2 -4.8 2.5 0 0 0</pose>
      <link name="link">
