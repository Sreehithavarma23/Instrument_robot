          <geometry><box><size>0.18 0.02 0.01</size></box></geometry>
          <surface><friction><ode><mu>100</mu><mu2>100</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.02 0.01</size></box></geometry>
        </visual>
      </link>
    </model>

