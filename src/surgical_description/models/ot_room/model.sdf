<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ot_room">

    <static>true</static>

    <link name="room_link">

      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://ot_room/meshes/untitled.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script>
        </material>

      </visual>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ot_room/meshes/untitled.dae</uri>
          </mesh>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
