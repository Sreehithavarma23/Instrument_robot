<sdf version="1.6">
  <model name="scalpel">
    <static>false</static>

    <link name="link">

      <!-- 🔥 REQUIRED -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.3 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>   <!-- RED -->
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>